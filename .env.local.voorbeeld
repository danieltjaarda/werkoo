# Kopieer dit bestand naar .env.local en vul je eigen waarden in.

# Lokaal: postgresql://localhost:5432/werkoo
# Op Vercel: de connection string van Neon of Supabase.
DATABASE_URL=postgresql://localhost:5432/werkoo

# Het adres waarop de site draait. Zonder deze waarde komen er localhost-urls
# in de sitemap en in alle canonicals.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chatassistent (Wout) via OpenRouter
OPENROUTER_API_KEY=
